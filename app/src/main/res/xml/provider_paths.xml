<?xml version="1.0" encoding="utf-8"?>
<paths>
    <external-path path="Android/data/${applicationId}/" name="package_root" />
    <cache-path path="Android/data/${applicationId}/" name="cache" />
    <cache-path path="open_with/" name="open_with" />
    <!--
    Only mounted storage volumes (primary and removable) are exposed, not the whole filesystem.
    The names are relied upon by FileUtils.fromContentUri().
    -->
    <root-path path="storage/" name="storage_root" />
    <root-path path="mnt/media_rw/" name="media_rw_root" />
</paths>
